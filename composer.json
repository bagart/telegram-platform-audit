{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-platform-audit",
    "description": "Audit module for the Telegram bot platform: append-only audit sink contract with typed, versioned audit entries as pure domain types",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "tg-bot",
        "bot-platform",
        "audit",
        "audit-log",
        "observability",
        "module"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramBotAudit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php ../../../vendor/bin/pest"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../telegram-bot-lib"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
